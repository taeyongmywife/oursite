---
interface Props {
  placeholder?: string;
}

const { placeholder = "搜索文章、主题、概念…" } = Astro.props;
---

<div class="search-block">
  <div class="search-title">SEARCH · 搜索</div>
  <div class="search-input-wrap">
    <input
      type="search"
      class="search-input"
      placeholder={placeholder}
      aria-label="站内搜索"
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <ul class="search-results" id="search-results" hidden></ul>
  <div class="search-empty" id="search-empty" hidden>没有匹配的结果</div>
</div>

<style>
  .search-block {
    padding: var(--space-10) 0;
    border-top: 1px solid var(--rock-basalt);
    border-bottom: 1px solid var(--rock-basalt);
  }

  .search-title {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--paper-bone);
    margin-bottom: var(--space-4);
  }

  .search-input-wrap {
    display: flex;
  }

  .search-input {
    width: 100%;
    background: transparent;
    border: 1px solid var(--rock-basalt);
    border-radius: 0;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--paper-bone);
    letter-spacing: 0.05em;
    outline: none;
    transition:
      border-color 300ms var(--ease-out),
      box-shadow 300ms var(--ease-out);
  }

  .search-input::placeholder {
    color: var(--rock-granite);
  }

  .search-input:focus {
    border-color: var(--mineral-copper);
    box-shadow: 0 0 0 1px var(--mineral-copper);
  }

  .search-results {
    list-style: none;
    margin: var(--space-4) 0 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .search-result-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--paper-bone);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition:
      border-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      background 200ms var(--ease-out);
  }

  .search-result-link:hover {
    color: var(--mineral-copper);
    border-left-color: var(--mineral-copper);
    background: rgba(184, 115, 51, 0.06);
  }

  .search-empty {
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--rock-granite);
    letter-spacing: 0.1em;
  }

  @media (max-width: 768px) {
    .search-block {
      padding: var(--space-8) 0;
    }
  }
</style>

<script>
  const input = document.querySelector(
    ".search-input"
  ) as HTMLInputElement | null;
  const results = document.querySelector(
    "#search-results"
  ) as HTMLUListElement | null;
  const empty = document.querySelector("#search-empty") as HTMLDivElement | null;

  let INDEX: Array<{
    title: string;
    slug: string;
    category: string | null;
    summary: string;
    tagBox: string[];
    keywords: string[];
  }> = [];
  let loaded = false;

  async function loadIndex() {
    if (loaded) return;
    try {
      const res = await fetch("/search-index.json");
      if (res.ok) {
        INDEX = await res.json();
      }
    } catch (e) {
      /* 离线 / 构建期缺失时静默降级 */
    }
    loaded = true;
  }

  function search(q: string) {
    if (!results || !empty) return;
    const query = q.trim().toLowerCase();
    if (!query) {
      results.hidden = true;
      empty.hidden = true;
      results.innerHTML = "";
      return;
    }

    const matches = INDEX.filter((item) => {
      const hay = [
        item.title,
        item.summary,
        (item.tagBox || []).join(" "),
        (item.keywords || []).join(" "),
        item.category || "",
      ]
        .join(" ")
        .toLowerCase();
      return hay.includes(query);
    }).slice(0, 8);

    results.innerHTML = "";
    if (matches.length === 0) {
      results.hidden = true;
      empty.hidden = false;
      return;
    }
    empty.hidden = true;
    results.hidden = false;

    for (const m of matches) {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = `/blog/${m.slug}`;
      a.className = "search-result-link";
      a.textContent = m.title;
      li.appendChild(a);
      results.appendChild(li);
    }
  }

  input?.addEventListener("input", (e) => {
    search((e.target as HTMLInputElement).value);
  });
  input?.addEventListener("focus", loadIndex);
  // 预加载索引（不阻塞渲染）
  loadIndex();
</script>
