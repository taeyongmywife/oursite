---
export interface LexicalNode {
  type: string;
  format?: number;
  indent?: number;
  version?: number;
  children?: LexicalNode[];
  text?: string;
  tag?: string;
  listType?: string;
  url?: string;
  direction?: string | null;
  relationTo?: string;
  value?: Record<string, unknown>;
}

interface Props {
  content: { root: LexicalNode } | LexicalNode;
  knowledgeMap?: Record<string, string>;
  /** slug → 词条信息（term/summary），用于行内知识词条的 <details> 展开 */
  knowledgeEntries?: Record<string, { term: string; summary: string }>;
}

const { content, knowledgeMap = {}, knowledgeEntries = {} } = Astro.props;
const rootNode = "root" in content ? content.root : content;

// LLM Review 引用触发点序号（与 extractLLMResponses 顺序一致，从 1 开始）
let citeSeq = 0;

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

const regexCache = new WeakMap<Record<string, string>, RegExp>();
function buildKnowledgeRegex(km: Record<string, string>): RegExp {
  const cached = regexCache.get(km);
  if (cached) return cached;

  const terms = Object.keys(km).sort((a, b) => b.length - a.length);
  if (terms.length === 0) {
    const never = /(?!)/; // never matches
    regexCache.set(km, never);
    return never;
  }

  // 纯 ASCII 词加前后边界，避免 "C" / "SSR" 误匹配进单词内部；
  // 含 CJK 或符号的词不加边界（CJK 无 \b，且常与拉丁字相邻，需整段匹配）。
  const escaped = terms.map((t) => {
    const e = t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    return /^[A-Za-z0-9]+$/.test(t) ? `(?<![A-Za-z0-9])${e}(?![A-Za-z0-9])` : e;
  });

  const regex = new RegExp(`(${escaped.join("|")})`, "gi");
  regexCache.set(km, regex);
  return regex;
}

function applyKnowledgeLinks(
  text: string,
  km: Record<string, string>,
  ke: Record<string, { term: string; summary: string }>
): string {
  if (Object.keys(km).length === 0) return text;
  const regex = buildKnowledgeRegex(km);
  return text.replace(regex, (match) => {
    const slug = km[match.toLowerCase()];
    if (!slug) return match;
    // 行内 <details> 展开（零脚本）：点词条就地展开摘要卡片，含「查看全部」跳转
    const entry = ke[slug];
    const term = entry?.term || match;
    const summary = entry?.summary?.trim() ? entry.summary : "暂无摘要，点击「查看全部」阅读完整词条。";
    return `<details class="k-word"><summary>${escapeHtml(term)}</summary><div class="k-pop"><p>${escapeHtml(summary)}</p><a href="/knowledge/${escapeHtml(slug)}">查看全部</a></div></details>`;
  });
}

function renderInline(node: LexicalNode, km: Record<string, string> = {}, ke: Record<string, { term: string; summary: string }> = {}): string {
  if (node.type === "linebreak") return "<br>";

  if (node.type === "text") {
    const raw = node.text ?? "";
    let text = escapeHtml(raw);

    // Apply knowledge links to raw text (before format wrapping)
    if (Object.keys(km).length > 0 && raw) {
      if (node.format) {
        // If text has formatting, apply links inside the format wrapper
        const linked = applyKnowledgeLinks(text, km, ke);
        const fmt = node.format;
        if (fmt & 1) return `<strong>${linked}</strong>`;
        if (fmt & 2) return `<em>${linked}</em>`;
        // For other formats, apply links first then format
        text = linked;
        if (fmt & 4) text = `<u>${text}</u>`;
        if (fmt & 8) text = `<s>${text}</s>`;
        if (fmt & 16) text = `<code>${text}</code>`;
        return text;
      } else {
        // No format, just apply links
        return applyKnowledgeLinks(text, km, ke);
      }
    }

    if (node.format) {
      const fmt = node.format;
      if (fmt & 1) text = `<strong>${text}</strong>`;
      if (fmt & 2) text = `<em>${text}</em>`;
      if (fmt & 4) text = `<u>${text}</u>`;
      if (fmt & 8) text = `<s>${text}</s>`;
      if (fmt & 16) text = `<code>${text}</code>`;
    }
    return text;
  }

  if (node.type === "link") {
    const href = escapeHtml(node.url ?? "#");
    const inner = (node.children ?? []).map((c) => renderInline(c, km, knowledgeEntries)).join("");
    return `<a href="${href}" target="_blank" rel="noopener noreferrer">${inner}</a>`;
  }

  return "";
}

function renderBlock(node: LexicalNode, km: Record<string, string> = {}): string {
  switch (node.type) {
    case "root":
    case "section": {
      return (node.children ?? []).map((c) => renderBlock(c, km)).join("\n");
    }

    case "paragraph": {
      const inner = (node.children ?? []).map((c) => renderInline(c, km, knowledgeEntries)).join("");
      return inner ? `<p>${inner}</p>` : "";
    }

    case "heading": {
      const tag = node.tag ?? "h2";
      const inner = (node.children ?? []).map((c) => renderInline(c, km, knowledgeEntries)).join("");
      return `<${tag}>${inner}</${tag}>`;
    }

    case "list": {
      const listTag = node.listType === "number" ? "ol" : "ul";
      const items = (node.children ?? []).map((c) => renderBlock(c, km)).join("\n");
      return `<${listTag}>\n${items}\n</${listTag}>`;
    }

    case "listitem": {
      const inner = (node.children ?? []).map((c) => renderInline(c, km, knowledgeEntries)).join("");
      return `<li>${inner}</li>`;
    }

    case "blockquote": {
      const inner = (node.children ?? []).map((c) => renderBlock(c, km)).join("\n");
      return `<blockquote>${inner}</blockquote>`;
    }

    case "horizontalrule": {
      return "<hr>";
    }

    // Lexical 表格（EXPERIMENTAL_TableFeature）
    case "table": {
      const rows = (node.children ?? []).map((c) => renderBlock(c, km)).join("");
      return `<div class="lexical-table-wrap"><table><tbody>${rows}</tbody></table></div>`;
    }

    case "tablerow": {
      const cells = (node.children ?? []).map((c) => renderBlock(c, km)).join("");
      return `<tr>${cells}</tr>`;
    }

    case "tablecell": {
      const raw = node as Record<string, unknown>;
      const headerState = Number(raw.headerState ?? 0);
      const tag = headerState > 0 ? "th" : "td";
      const colSpan = Number(raw.colSpan ?? 1) > 1 ? ` colspan="${Number(raw.colSpan)}"` : "";
      const rowSpan = Number(raw.rowSpan ?? 1) > 1 ? ` rowspan="${Number(raw.rowSpan)}"` : "";
      // 单元格 children 是 paragraph 包裹的文本，需逐层取内联内容
      const inner = (node.children ?? [])
        .map((c) => {
          const c2 = c as Record<string, unknown>;
          if (c2.type === "paragraph") {
            return ((c2.children ?? []) as LexicalNode[]).map((x) => renderInline(x, km, knowledgeEntries)).join("");
          }
          return renderInline(c, km, knowledgeEntries);
        })
        .join("");
      return `<${tag}${colSpan}${rowSpan}>${inner || "&nbsp;"}</${tag}>`;
    }

    case "llmResponse": {
      // 模型原文不进入正文（SEO 干净）：只渲染触发按钮，正文通过 data-cite-id 关联页面级 JSON payload。
      citeSeq += 1;
      const id = citeSeq;
      return `<button type="button" class="llm-cite-trigger" data-cite-id="${id}" aria-haspopup="dialog" aria-controls="llm-cite-panel" aria-expanded="false">查看原文<span class="llm-cite-trigger-icon"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 3.5h8v6H7.5L5 12v-2.5H4v-6z" stroke="currentColor" stroke-width="1.2"/><path d="M6 6h4M6 8h3" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg></span></button>`;
    }

    case "code": {
      const code = (node.children ?? []).map((c) => c.text ?? "").join("");
      const lang = (node as Record<string, string>).language ?? "";
      const langAttr = lang ? ` class="language-${escapeHtml(lang)}"` : "";
      return `<pre><code${langAttr}>${escapeHtml(code)}</code></pre>`;
    }

    case "upload": {
      const val = node.value as Record<string, unknown> | undefined;
      if (val && typeof val === "object") {
        const src = val.url ? String(val.url) : "";
        const alt = val.alt ? String(val.alt) : "";
        const w = val.width ? ` width="${val.width}"` : "";
        const h = val.height ? ` height="${val.height}"` : "";
        if (src) return `<img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}"${w}${h} loading="lazy">`;
      }
      return "";
    }

    default: {
      const fallback = (node.children ?? []).map((c) => renderInline(c, km, knowledgeEntries)).join("");
      return fallback ? `<p>${fallback}</p>` : "";
    }
  }
}

const html = renderBlock(rootNode, knowledgeMap);
---

<Fragment set:html={html} />

<style>
/* ===== 行内知识词条（<details> 展开，零脚本） ===== */
.k-word {
  display: inline;
}

.k-word summary {
  display: inline;
  list-style: none;
  cursor: pointer;
  color: var(--mineral-copper);
  border-bottom: 1px dashed var(--mineral-moss);
  transition: border-color var(--duration-base) var(--ease-out);
}

.k-word summary::-webkit-details-marker {
  display: none;
}

.k-word summary:hover {
  border-bottom-color: var(--mineral-copper);
}

.k-word summary:focus-visible {
  outline: 2px solid var(--mineral-copper);
  outline-offset: 2px;
}

.k-pop {
  display: block;
  margin: var(--space-3) 0 var(--space-4) 0;
  padding: var(--space-3) var(--space-4);
  border-left: 2px solid var(--border-active);
  background: var(--bg-shelf);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--paper-rust);
  white-space: pre-wrap;
}

.k-pop p {
  margin: 0 0 var(--space-2) 0;
}

.k-pop a {
  color: var(--mineral-copper);
  text-decoration: none;
  font-size: var(--text-xs);
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.k-pop a:hover {
  text-decoration: underline;
}

/* ===== Lexical 表格（站内极简风） ===== */
.lexical-table-wrap {
  margin: var(--space-8) 0;
  overflow-x: auto;
  border: var(--border-solid);
}

.lexical-table-wrap table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 1.5;
}

.lexical-table-wrap th,
.lexical-table-wrap td {
  padding: var(--space-2) var(--space-4);
  border: 1px solid var(--rock-basalt);
  text-align: left;
  vertical-align: top;
}

.lexical-table-wrap th {
  font-family: var(--font-serif);
  font-size: var(--text-sm);
  color: var(--paper-bone);
  background: var(--bg-shelf);
  letter-spacing: 0.02em;
}

.lexical-table-wrap td {
  color: var(--paper-rust);
}
</style>
