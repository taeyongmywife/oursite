---
import { parseLLMMarkers, containsLLMMarker } from "../lib/llmMarkers";

export interface LexicalNode {
  type: string;
  format?: number;
  indent?: number;
  version?: number;
  children?: LexicalNode[];
  text?: string;
  tag?: string;
  listType?: string;
  url?: string;
  direction?: string | null;
  relationTo?: string;
  value?: Record<string, unknown>;
}

interface Props {
  content: { root: LexicalNode } | LexicalNode;
  knowledgeMap?: Record<string, string>;
}

const { content, knowledgeMap = {} } = Astro.props;
const rootNode = "root" in content ? content.root : content;

// LLM Review 引用触发点序号（与 extractLLMResponses 顺序一致，从 1 开始）
let citeSeq = 0;
// 内联知识链接去重：同一 slug 全篇只高亮首次出现，避免反复打断阅读
let linkedSlugs = new Set<string>();

function escapeHtml(str: string): string {
  return str
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;");
}

const regexCache = new WeakMap<Record<string, string>, RegExp>();
function buildKnowledgeRegex(km: Record<string, string>): RegExp {
  const cached = regexCache.get(km);
  if (cached) return cached;

  const terms = Object.keys(km).sort((a, b) => b.length - a.length);
  if (terms.length === 0) {
    const never = /(?!)/; // never matches
    regexCache.set(km, never);
    return never;
  }

  // 纯 ASCII 词加前后边界，避免 "C" / "SSR" 误匹配进单词内部；
  // 含 CJK 或符号的词不加边界（CJK 无 \b，且常与拉丁字相邻，需整段匹配）。
  const escaped = terms.map((t) => {
    const e = t.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
    return /^[A-Za-z0-9]+$/.test(t) ? `(?<![A-Za-z0-9])${e}(?![A-Za-z0-9])` : e;
  });

  const regex = new RegExp(`(${escaped.join("|")})`, "gi");
  regexCache.set(km, regex);
  return regex;
}

function applyKnowledgeLinks(text: string, km: Record<string, string>): string {
  if (Object.keys(km).length === 0) return text;
  const regex = buildKnowledgeRegex(km);
  return text.replace(regex, (match) => {
    const slug = km[match.toLowerCase()];
    if (!slug) return match;
    // 同一词条全篇只高亮第一次出现，后续出现保持纯文本，减少视觉干扰
    if (linkedSlugs.has(slug)) return match;
    linkedSlugs.add(slug);
    // 输出按钮触发浮层预览（与 KnowledgeReference 复用同一个 payload + script）
    return `<button type="button" class="knowledge-link knowledge-preview-trigger" data-knowledge-slug="${escapeHtml(slug)}" aria-haspopup="dialog" aria-controls="knowledge-overlay-panel" aria-expanded="false">${escapeHtml(match)}</button>`;
  });
}

/**
 * 方案A：[[llm:...]] 纯文本标记。
 * 提取段落内纯文本（text 拼接、linebreak→\n），与 payload.ts 的 extractLLMResponses
 * 拼接规则一致，保证渲染顺序 = 提取顺序（citeId 一一对应）。
 */
function paragraphPlainText(node: LexicalNode): string {
  return (node.children ?? [])
    .map((c) => {
      if (c.type === "text") return c.text ?? "";
      if (c.type === "linebreak") return "\n";
      return "";
    })
    .join("");
}

/** 与 llmResponse 节点相同的触发按钮 HTML（含图标），viewText 由标记第 2 段定制 */
function llmTriggerHtml(id: number, viewText: string): string {
  return `<button type="button" class="llm-cite-trigger" data-cite-id="${id}" aria-haspopup="dialog" aria-controls="llm-cite-panel" aria-expanded="false">${escapeHtml(viewText)}<span class="llm-cite-trigger-icon"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 3.5h8v6H7.5L5 12v-2.5H4v-6z" stroke="currentColor" stroke-width="1.2"/><path d="M6 6h4M6 8h3" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg></span></button>`;
}

/**
 * 渲染含 [[llm:...]] 标记的段落：
 * 整段按纯文本拼接（忽略段内格式，标记引用段落本就无格式），
 * 标记替换为触发按钮，标记外文本 escapeHtml 原样输出。
 * 知识链接（applyKnowledgeLinks）在标记段落内不应用——避免与按钮穿插冲突。
 */
function renderParagraphWithMarkers(text: string): string {
  const { markers } = parseLLMMarkers(text);
  if (markers.length === 0) return "";
  let out = "";
  let last = 0;
  for (const m of markers) {
    citeSeq += 1;
    out += escapeHtml(text.slice(last, m.index));
    out += llmTriggerHtml(m.citeId, m.viewText);
    last = m.index + m.length;
  }
  out += escapeHtml(text.slice(last));
  return `<p>${out}</p>`;
}

function renderInline(node: LexicalNode, km: Record<string, string> = {}): string {
  if (node.type === "linebreak") return "<br>";

  if (node.type === "text") {
    const raw = node.text ?? "";
    let text = escapeHtml(raw);

    // Apply knowledge links to raw text (before format wrapping)
    if (Object.keys(km).length > 0 && raw) {
      if (node.format) {
        // If text has formatting, apply links inside the format wrapper
        const linked = applyKnowledgeLinks(text, km);
        const fmt = node.format;
        if (fmt & 1) return `<strong>${linked}</strong>`;
        if (fmt & 2) return `<em>${linked}</em>`;
        // For other formats, apply links first then format
        text = linked;
        if (fmt & 4) text = `<u>${text}</u>`;
        if (fmt & 8) text = `<s>${text}</s>`;
        if (fmt & 16) text = `<code>${text}</code>`;
        return text;
      } else {
        // No format, just apply links
        return applyKnowledgeLinks(text, km);
      }
    }

    if (node.format) {
      const fmt = node.format;
      if (fmt & 1) text = `<strong>${text}</strong>`;
      if (fmt & 2) text = `<em>${text}</em>`;
      if (fmt & 4) text = `<u>${text}</u>`;
      if (fmt & 8) text = `<s>${text}</s>`;
      if (fmt & 16) text = `<code>${text}</code>`;
    }
    return text;
  }

  if (node.type === "link") {
    // Lexical 3.86 的 url 在 fields 上（node.url 为历史遗留空值，已修正）。
    const fields = (node as Record<string, any>).fields ?? {};
    const refId = typeof fields.refId === "string" ? fields.refId : "";
    const inner = (node.children ?? []).map((c) => renderInline(c, km)).join("");
    // Inline Reference 锚点：refId 非空 → 渲染成展开触发按钮（不产生跳转）。
    if (refId) {
      return `<button type="button" class="inline-ref-trigger" data-inline-ref-id="${escapeHtml(refId)}" aria-haspopup="dialog" aria-controls="inline-ref-panel" aria-expanded="false">${inner}</button>`;
    }
    // 普通链接：仅当存在有效 url 时才输出 <a>；
    // 否则（如孤立的 internal link 脏数据，无 url 也无 refId）降级为纯文本，避免 <a href="#"> 死链。
    const href = typeof fields.url === "string" && fields.url ? fields.url : "";
    if (href) {
      return `<a href="${escapeHtml(href)}" target="_blank" rel="noopener noreferrer">${inner}</a>`;
    }
    return inner;
  }

  return "";
}

function renderBlock(node: LexicalNode, km: Record<string, string> = {}): string {
  switch (node.type) {
    case "root":
    case "section": {
      return (node.children ?? []).map((c) => renderBlock(c, km)).join("\n");
    }

    case "paragraph": {
      const plain = paragraphPlainText(node);
      // 方案A：[[llm:...]] 标记段落 → 替换为触发按钮（整段纯文本渲染）
      if (containsLLMMarker(plain)) {
        return renderParagraphWithMarkers(plain);
      }
      const inner = (node.children ?? []).map((c) => renderInline(c, km)).join("");
      return inner ? `<p>${inner}</p>` : "";
    }

    case "heading": {
      const tag = node.tag ?? "h2";
      const inner = (node.children ?? []).map((c) => renderInline(c, km)).join("");
      return `<${tag}>${inner}</${tag}>`;
    }

    case "list": {
      const listTag = node.listType === "number" ? "ol" : "ul";
      const items = (node.children ?? []).map((c) => renderBlock(c, km)).join("\n");
      return `<${listTag}>\n${items}\n</${listTag}>`;
    }

    case "listitem": {
      const inner = (node.children ?? []).map((c) => renderInline(c, km)).join("");
      return `<li>${inner}</li>`;
    }

    case "blockquote": {
      const inner = (node.children ?? []).map((c) => renderBlock(c, km)).join("\n");
      return `<blockquote>${inner}</blockquote>`;
    }

    case "horizontalrule": {
      return "<hr>";
    }

    // Lexical 表格（EXPERIMENTAL_TableFeature）
    case "table": {
      const rows = (node.children ?? []).map((c) => renderBlock(c, km)).join("");
      return `<div class="lexical-table-wrap"><table><tbody>${rows}</tbody></table></div>`;
    }

    case "tablerow": {
      const cells = (node.children ?? []).map((c) => renderBlock(c, km)).join("");
      return `<tr>${cells}</tr>`;
    }

    case "tablecell": {
      const raw = node as Record<string, unknown>;
      const headerState = Number(raw.headerState ?? 0);
      const tag = headerState > 0 ? "th" : "td";
      const colSpan = Number(raw.colSpan ?? 1) > 1 ? ` colspan="${Number(raw.colSpan)}"` : "";
      const rowSpan = Number(raw.rowSpan ?? 1) > 1 ? ` rowspan="${Number(raw.rowSpan)}"` : "";
      // 单元格 children 是 paragraph 包裹的文本，需逐层取内联内容
      const inner = (node.children ?? [])
        .map((c) => {
          const c2 = c as Record<string, unknown>;
          if (c2.type === "paragraph") {
            return ((c2.children ?? []) as LexicalNode[]).map((x) => renderInline(x, km)).join("");
          }
          return renderInline(c, km);
        })
        .join("");
      return `<${tag}${colSpan}${rowSpan}>${inner || "&nbsp;"}</${tag}>`;
    }

    case "llmResponse": {
      // 模型原文不进入正文（SEO 干净）：只渲染触发按钮，正文通过 data-cite-id 关联页面级 JSON payload。
      // 按钮文字取 CMS 可配置的 viewText，缺省回退「查看原文」。
      citeSeq += 1;
      const id = citeSeq;
      const d = (node as Record<string, unknown>).data as Record<string, unknown> | undefined;
      const rawView = typeof d?.viewText === "string" ? d.viewText.trim() : "";
      const viewText = rawView ? rawView : "查看原文";
      return `<button type="button" class="llm-cite-trigger" data-cite-id="${id}" aria-haspopup="dialog" aria-controls="llm-cite-panel" aria-expanded="false">${escapeHtml(viewText)}<span class="llm-cite-trigger-icon"><svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 3.5h8v6H7.5L5 12v-2.5H4v-6z" stroke="currentColor" stroke-width="1.2"/><path d="M6 6h4M6 8h3" stroke="currentColor" stroke-width="1" stroke-linecap="round"/></svg></span></button>`;
    }

    case "code": {
      const code = (node.children ?? []).map((c) => c.text ?? "").join("");
      const lang = (node as Record<string, string>).language ?? "";
      const langAttr = lang ? ` class="language-${escapeHtml(lang)}"` : "";
      return `<pre><code${langAttr}>${escapeHtml(code)}</code></pre>`;
    }

    case "upload": {
      const val = node.value as Record<string, unknown> | undefined;
      if (val && typeof val === "object") {
        const src = val.url ? String(val.url) : "";
        const alt = val.alt ? String(val.alt) : "";
        const w = val.width ? ` width="${val.width}"` : "";
        const h = val.height ? ` height="${val.height}"` : "";
        if (src) return `<img src="${escapeHtml(src)}" alt="${escapeHtml(alt)}"${w}${h} loading="lazy">`;
      }
      return "";
    }

    default: {
      const fallback = (node.children ?? []).map((c) => renderInline(c, km)).join("");
      return fallback ? `<p>${fallback}</p>` : "";
    }
  }
}

const html = renderBlock(rootNode, knowledgeMap);
---

<Fragment set:html={html} />

{/*
  正文 HTML 由 set:html 注入，Astro 的 scoped 样式不会带 data-astro-cid 属性，
  因此这里的样式必须 is:global 才能作用到内联 knowledge-link / llm-cite-trigger 按钮与表格。
*/}
<style is:global>
.knowledge-link {
  appearance: none;
  background: transparent;
  border: 0;
  padding: 0;
  font: inherit;
  cursor: pointer;
  color: var(--mineral-copper);
  border-bottom: 1px dashed var(--mineral-moss);
  transition: border-color var(--duration-base) var(--ease-out);
}

.knowledge-link:hover,
.knowledge-link[aria-expanded="true"] {
  border-bottom-color: var(--mineral-copper);
}

.knowledge-link:focus-visible {
  outline: 2px solid var(--mineral-copper);
  outline-offset: 2px;
}

/* 模型原文「查看原文」触发按钮：同样用 set:html 注入，需 global 才能去白块 */
.llm-cite-trigger {
  appearance: none;
  background: transparent;
  border: 0;
  padding: 0;
  margin-left: 0.25em;
  font: inherit;
  cursor: pointer;
  color: var(--mineral-copper);
  border-bottom: 1px dotted var(--mineral-copper);
  white-space: nowrap;
  transition: border-color var(--duration-base) var(--ease-out);
}

.llm-cite-trigger:hover,
.llm-cite-trigger[aria-expanded="true"] {
  border-bottom-color: var(--mineral-moss);
}

.llm-cite-trigger:focus-visible {
  outline: 2px solid var(--mineral-copper);
  outline-offset: 2px;
}

.llm-cite-trigger-icon {
  display: inline-flex;
  vertical-align: -0.12em;
  margin-left: 0.2em;
}

/* ===== Lexical 表格（站内极简风） ===== */
.lexical-table-wrap {
  margin: var(--space-8) 0;
  overflow-x: auto;
  border: var(--border-solid);
}

.lexical-table-wrap table {
  width: 100%;
  border-collapse: collapse;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 1.5;
}

.lexical-table-wrap th,
.lexical-table-wrap td {
  padding: var(--space-2) var(--space-4);
  border: 1px solid var(--rock-basalt);
  text-align: left;
  vertical-align: top;
}

.lexical-table-wrap th {
  font-family: var(--font-serif);
  font-size: var(--text-sm);
  color: var(--paper-bone);
  background: var(--bg-shelf);
  letter-spacing: 0.02em;
}

.lexical-table-wrap td {
  color: var(--paper-rust);
}
</style>
