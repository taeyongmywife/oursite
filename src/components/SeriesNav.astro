---
import { getPosts, type PayloadPost } from "../lib/payload";

interface Props {
  post: PayloadPost;
}

const { post } = Astro.props;

const seriesRaw = post.series ?? null;
const seriesSlug =
  seriesRaw && typeof seriesRaw === "object" ? seriesRaw.slug : null;
const seriesTitle =
  seriesRaw && typeof seriesRaw === "object" ? seriesRaw.title : null;
const logNumber = post.logNumber ?? null;

let prevPost: PayloadPost | null = null;
let nextPost: PayloadPost | null = null;

// 同一 Series 内的连续阅读：按 logNumber 升序排，取当前篇的上下篇
if (seriesSlug) {
  const seriesPosts = (await getPosts())
    .filter((p) => {
      const s = p.series;
      const slug = s && typeof s === "object" ? s.slug : null;
      return slug === seriesSlug;
    })
    .sort((a, b) => (a.logNumber ?? 0) - (b.logNumber ?? 0));

  const idx = seriesPosts.findIndex((p) => p.slug === post.slug);
  if (idx > 0) prevPost = seriesPosts[idx - 1];
  if (idx >= 0 && idx < seriesPosts.length - 1) {
    nextPost = seriesPosts[idx + 1];
  }
}

const hasSeries = Boolean(seriesSlug);
const logLabel = logNumber != null ? `#${String(logNumber).padStart(3, "0")}` : "";
---

{hasSeries && (
  <nav class="series-nav" aria-label="Series navigation">
    <div class="series-head">
      <span class="series-kicker">SERIES</span>
      <span class="series-name">{seriesTitle}</span>
      {logNumber != null && <span class="series-num">{logLabel}</span>}
    </div>

    {(prevPost || nextPost) && (
      <div class="series-steps">
        {prevPost ? (
          <a class="series-step prev" href={`/blog/${prevPost.slug}`}>
            <span class="step-dir">← PREV LOG</span>
            <span class="step-title">{prevPost.title}</span>
          </a>
        ) : (
          <span class="series-step prev disabled">—</span>
        )}
        {nextPost ? (
          <a class="series-step next" href={`/blog/${nextPost.slug}`}>
            <span class="step-dir">NEXT LOG →</span>
            <span class="step-title">{nextPost.title}</span>
          </a>
        ) : (
          <span class="series-step next disabled">—</span>
        )}
      </div>
    )}
  </nav>
)}

<style>
  .series-nav {
    margin: var(--space-12) 0;
    padding: var(--space-5) var(--space-6);
    border: var(--border-thin);
    background: var(--bg-shelf);
  }

  .series-head {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .series-kicker {
    color: var(--rock-granite);
  }

  .series-name {
    color: var(--mineral-copper);
  }

  .series-num {
    color: var(--paper-bone);
    margin-left: auto;
  }

  .series-steps {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    margin-top: var(--space-4);
  }

  .series-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-decoration: none;
    font-size: var(--text-sm);
  }

  .series-step.next {
    text-align: right;
    margin-left: auto;
  }

  .series-step.prev.disabled,
  .series-step.next.disabled {
    color: var(--rock-granite);
  }

  .step-dir {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--rock-granite);
  }

  .step-title {
    color: var(--paper-bone);
    transition: color var(--duration-base) var(--ease-out);
  }

  a.series-step:hover .step-title {
    color: var(--mineral-copper);
  }
</style>
