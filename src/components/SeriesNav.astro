---
import { getPosts, getSeriesAdjacent, postPathOf, type PayloadPost } from "../lib/payload";

interface Props {
  post: PayloadPost;
}

const { post } = Astro.props;

const seriesRaw = post.series ?? null;
const seriesSlug =
  seriesRaw && typeof seriesRaw === "object" ? seriesRaw.slug : null;
const seriesTitle =
  seriesRaw && typeof seriesRaw === "object" ? seriesRaw.title : null;
const logNumber = post.logNumber ?? null;

let prevPost: PayloadPost | null = null;
let nextPost: PayloadPost | null = null;

// 同一 Series 内的连续阅读：按 logNumber 升序排，取当前篇的上下篇
if (seriesSlug) {
  const { prevSlug, nextSlug } = await getSeriesAdjacent(post);
  const all = await getPosts();
  if (prevSlug) prevPost = all.find((p) => p.slug === prevSlug) ?? null;
  if (nextSlug) nextPost = all.find((p) => p.slug === nextSlug) ?? null;
}

const hasSeries = Boolean(seriesSlug);
const hasAdjacent = Boolean(prevPost || nextPost);
const seriesKicker = seriesTitle ? `SERIES · ${seriesTitle}` : "SERIES";
const logLabel = logNumber != null ? `#${String(logNumber).padStart(3, "0")}` : "";
---

{hasSeries && hasAdjacent && (
  <nav class="series-nav" aria-label="Series navigation">
    <div class="series-head">
      <span class="series-kicker">{seriesKicker}</span>
      {logNumber != null && <span class="series-num">{logLabel}</span>}
    </div>

    <div class="series-steps">
      {prevPost ? (
        <a class="series-step prev" href={postPathOf(prevPost)} title={prevPost.title}>
          <span class="step-dir">← 上一篇 · PREV</span>
          <span class="step-title">{prevPost.title}</span>
        </a>
      ) : (
        <span class="series-step prev disabled">
          <span class="step-dir">·</span>
          <span class="step-title">系列首篇 · FIRST</span>
        </span>
      )}
      {nextPost ? (
        <a class="series-step next" href={postPathOf(nextPost)} title={nextPost.title}>
          <span class="step-dir">下一篇 · NEXT →</span>
          <span class="step-title">{nextPost.title}</span>
        </a>
      ) : (
        <span class="series-step next disabled">
          <span class="step-dir">·</span>
          <span class="step-title">系列末篇 · LAST</span>
        </span>
      )}
    </div>
  </nav>
)}

<style>
  .series-nav {
    margin: var(--space-12) 0;
    padding: var(--space-5) var(--space-6);
    border: var(--border-solid);
    background: var(--bg-surface);
  }

  .series-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .series-kicker {
    color: var(--rock-granite);
  }

  .series-num {
    color: var(--mineral-copper);
  }

  .series-steps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .series-step {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0; /* 允许标题在网格列内收缩，配合 ellipsis 截断 */
    text-decoration: none;
    color: var(--text-muted);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .series-step.next {
    text-align: right; /* 仅标签(FIRST/NEXT)保持右对齐以呼应右栏；标题始终左对齐 */
  }

  .series-step.disabled {
    cursor: default;
    color: var(--rock-granite);
  }

  .step-dir {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--rock-granite);
  }

  .step-title {
    display: block;
    width: 100%;
    font-size: var(--text-sm);
    color: var(--text-muted);
    text-align: left; /* 不论 PREV 还是 NEXT 栏，标题始终左对齐 */
    white-space: nowrap; /* 超长标题强制单行 */
    overflow: hidden;
    text-overflow: ellipsis; /* 超出容器宽度显示省略号，避免锯齿状换行 */
    transition: color var(--duration-fast) var(--ease-out);
  }

  a.series-step:hover .step-title {
    color: var(--text-primary);
  }

  a.series-step:hover {
    color: var(--text-primary);
  }
</style>