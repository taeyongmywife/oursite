---
interface Props {
  placeholder?: string;
}

const { placeholder = "搜索文章、主题、概念…" } = Astro.props;
---

<div class="search-overlay" data-search-overlay hidden aria-hidden="true">
  <div class="search-overlay-scrim" data-search-scrim></div>
  <div class="search-overlay-panel" role="dialog" aria-modal="true" aria-label="搜索 / Search">
    <div class="search-overlay-head">
      <span class="search-overlay-kicker">SEARCH · 搜索</span>
      <button
        type="button"
        class="search-overlay-close"
        data-search-close
        aria-label="关闭 / Close"
      >
        <span aria-hidden="true">×</span>
      </button>
    </div>
    <div class="search-field">
      <input
        id="search-overlay-input"
        type="search"
        class="search-input"
        placeholder={placeholder}
        aria-label="站内搜索"
        autocomplete="off"
        spellcheck="false"
        data-search-input
      />
    </div>
    <ul class="search-results" data-search-results hidden></ul>
    <div class="search-empty" data-search-empty hidden>没有匹配的结果</div>
    <div class="search-hint">
      <kbd>↑↓</kbd> 选择 · <kbd>Enter</kbd> 打开 · <kbd>Esc</kbd> 关闭
    </div>
  </div>
</div>

<style>
.search-overlay[hidden] {
  display: none;
}

.search-overlay {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding: 10vh var(--container-pad) 0;
}

.search-overlay-scrim {
  position: absolute;
  inset: 0;
  background: rgba(0, 0, 0, 0.72);
  backdrop-filter: blur(4px);
}

.search-overlay-panel {
  position: relative;
  width: min(640px, 100%);
  background: var(--bg-void);
  border: var(--border-solid);
  padding: var(--space-6);
  font-family: var(--font-mono);
}

.search-overlay-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--space-4);
}

.search-overlay-kicker {
  font-size: var(--text-xs);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--rock-granite);
}

.search-overlay-close {
  appearance: none;
  background: transparent;
  border: 0;
  padding: var(--space-1) var(--space-2);
  color: var(--text-muted);
  font-family: var(--font-mono);
  font-size: var(--text-lg);
  line-height: 1;
  cursor: pointer;
  transition: color var(--duration-fast) var(--ease-out);
}

.search-overlay-close:hover {
  color: var(--accent);
}

.search-field {
  position: relative;
  width: 100%;
}

.search-input {
  width: 100%;
  background: transparent;
  border: 1px solid var(--border);
  border-radius: 0;
  padding: var(--space-3) var(--space-4);
  font-family: var(--font-mono);
  font-size: var(--text-base);
  color: var(--text-primary);
  letter-spacing: 0.05em;
  outline: none;
  transition:
    border-color var(--duration-fast) var(--ease-out),
    box-shadow var(--duration-fast) var(--ease-out);
}

.search-input::placeholder {
  color: var(--rock-granite);
}

.search-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}

.search-results {
  list-style: none;
  margin: var(--space-4) 0 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
  max-height: 50vh;
  overflow-y: auto;
}

.search-result-link {
  display: block;
  padding: var(--space-2) var(--space-3);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--text-muted);
  text-decoration: none;
  border-left: 2px solid transparent;
  transition:
    color var(--duration-fast) var(--ease-out),
    border-color var(--duration-fast) var(--ease-out),
    background var(--duration-fast) var(--ease-out);
}

.search-result-link.is-active,
.search-result-link:hover {
  color: var(--text-primary);
  border-left-color: var(--accent);
  background: var(--bg-surface-2);
}

.search-empty {
  margin-top: var(--space-4);
  font-size: var(--text-xs);
  color: var(--rock-granite);
  letter-spacing: 0.1em;
}

.search-hint {
  margin-top: var(--space-4);
  padding-top: var(--space-3);
  border-top: 1px solid var(--border);
  font-size: var(--text-xs);
  color: var(--rock-granite);
  letter-spacing: 0.05em;
}

.search-hint kbd {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--text-muted);
  border: 1px solid var(--border);
  padding: 0 var(--space-1);
  margin: 0 2px;
}

@media (max-width: 768px) {
  .search-overlay {
    padding: 6vh var(--space-4) 0;
  }
  .search-overlay-panel {
    padding: var(--space-5);
  }
}
</style>

<script>
  const overlay = document.querySelector(
    "[data-search-overlay]"
  ) as HTMLElement | null;
  const scrim = document.querySelector(
    "[data-search-scrim]"
  ) as HTMLElement | null;
  const closeBtn = document.querySelector(
    "[data-search-close]"
  ) as HTMLButtonElement | null;
  const input = document.querySelector(
    "[data-search-input]"
  ) as HTMLInputElement | null;
  const results = document.querySelector(
    "[data-search-results]"
  ) as HTMLUListElement | null;
  const empty = document.querySelector(
    "[data-search-empty]"
  ) as HTMLDivElement | null;

  let INDEX: Array<{
    title: string;
    slug: string;
    category: string | null;
    summary: string;
    tagBox: string[];
    keywords: string[];
  }> = [];
  let loaded = false;
  let activeIdx = -1;

  async function loadIndex() {
    if (loaded) return;
    try {
      const res = await fetch("/search-index.json");
      if (res.ok) {
        INDEX = await res.json();
      }
    } catch (e) {
      /* 离线 / 构建期缺失时静默降级 */
    }
    loaded = true;
  }

  function resetResults() {
    if (!results || !empty) return;
    results.innerHTML = "";
    results.hidden = true;
    empty.hidden = true;
    activeIdx = -1;
  }

  function buildHref(item: { slug: string; category: string | null }): string {
    if (item.category === "blog" || !item.category) return `/blog/${item.slug}`;
    return `/${item.category}/${item.slug}`;
  }

  function renderResults(matches: typeof INDEX) {
    if (!results || !empty) return;
    results.innerHTML = "";
    activeIdx = -1;
    if (matches.length === 0) {
      results.hidden = true;
      empty.hidden = false;
      return;
    }
    empty.hidden = true;
    results.hidden = false;
    matches.forEach((m, i) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = buildHref(m);
      a.className = "search-result-link";
      a.dataset.idx = String(i);
      a.textContent = m.title;
      li.appendChild(a);
      results.appendChild(li);
    });
  }

  function search(q: string) {
    if (!results || !empty) return;
    const query = q.trim().toLowerCase();
    if (!query) {
      resetResults();
      return;
    }
    const matches = INDEX.filter((item) => {
      const hay = [
        item.title,
        item.summary,
        (item.tagBox || []).join(" "),
        (item.keywords || []).join(" "),
        item.category || "",
      ]
        .join(" ")
        .toLowerCase();
      return hay.includes(query);
    }).slice(0, 8);
    renderResults(matches);
  }

  function setActive(idx: number) {
    if (!results) return;
    const links = Array.from(
      results.querySelectorAll<HTMLAnchorElement>("a.search-result-link")
    );
    if (links.length === 0) return;
    activeIdx = ((idx % links.length) + links.length) % links.length;
    links.forEach((a, i) => a.classList.toggle("is-active", i === activeIdx));
    links[activeIdx]?.scrollIntoView({ block: "nearest" });
  }

  function openOverlay() {
    if (!overlay || !input) return;
    overlay.hidden = false;
    overlay.setAttribute("aria-hidden", "false");
    document.body.style.overflow = "hidden";
    loadIndex();
    requestAnimationFrame(() => input.focus());
  }

  function closeOverlay() {
    if (!overlay || !input) return;
    overlay.hidden = true;
    overlay.setAttribute("aria-hidden", "true");
    document.body.style.overflow = "";
    input.value = "";
    resetResults();
  }

  // Open triggers: any element with [data-search-open] + global keyboard shortcuts
  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;
    if (!target) return;
    const trigger = target.closest<HTMLElement>("[data-search-open]");
    if (trigger) {
      e.preventDefault();
      document.dispatchEvent(new CustomEvent("search:open"));
    }
  });

  document.addEventListener("search:open", () => openOverlay());

  document.addEventListener("keydown", (e) => {
    const meta = e.metaKey || e.ctrlKey;
    if (meta && e.key.toLowerCase() === "k") {
      e.preventDefault();
      openOverlay();
      return;
    }
    if (e.key === "Escape" && overlay && !overlay.hidden) {
      e.preventDefault();
      closeOverlay();
      return;
    }
    if (
      e.key === "/" &&
      overlay &&
      overlay.hidden &&
      !(document.activeElement instanceof HTMLInputElement) &&
      !(document.activeElement instanceof HTMLTextAreaElement) &&
      !(document.activeElement?.getAttribute("contenteditable") === "true")
    ) {
      e.preventDefault();
      openOverlay();
    }
  });

  input?.addEventListener("input", (e) => {
    search((e.target as HTMLInputElement).value);
  });

  input?.addEventListener("keydown", (e) => {
    if (!results) return;
    if (e.key === "ArrowDown") {
      e.preventDefault();
      setActive(activeIdx + 1);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      setActive(activeIdx - 1);
    } else if (e.key === "Enter") {
      e.preventDefault();
      const links = Array.from(
        results.querySelectorAll<HTMLAnchorElement>("a.search-result-link")
      );
      const target = links[activeIdx] ?? links[0];
      if (target) {
        window.location.href = target.href;
        closeOverlay();
      }
    } else if (e.key === "Escape") {
      e.preventDefault();
      closeOverlay();
    }
  });

  scrim?.addEventListener("click", () => closeOverlay());
  closeBtn?.addEventListener("click", () => closeOverlay());

  loadIndex();
</script>