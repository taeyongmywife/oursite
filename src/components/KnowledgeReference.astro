---
import Overlay from "./Overlay.astro";
import Button from "./Button.astro";

interface KnowledgeEntry {
  term: string;
  slug: string;
  summary?: string;
}

interface Props {
  entries: KnowledgeEntry[];
}

const { entries } = Astro.props;

// 触发点序号与 payload 索引一致（按出现顺序从 0 开始）
const payloadJson = JSON.stringify(entries).replace(/</g, "\\u003c");
---

{entries.length > 0 && (
  <>
    <section class="knowledge-related">
      <div class="related-title">RELATED KNOWLEDGE</div>
      <div class="related-list">
        {entries.map((entry, i) => (
          <button
            type="button"
            class="related-tag knowledge-preview-trigger"
            data-knowledge-idx={i}
            aria-haspopup="dialog"
            aria-controls="knowledge-overlay-panel"
            aria-expanded="false"
          >
            {entry.term}
          </button>
        ))}
      </div>
    </section>

    <Overlay labelledBy="knowledge-overlay-title" panelId="knowledge-overlay-panel">
      <div class="knowledge-preview-body" data-knowledge-summary></div>
      <div class="knowledge-preview-actions">
        <Button
          as="a"
          href="#"
          variant="outline"
          size="sm"
          dataAttrs={{ "knowledge-link": "" }}
        >
          查看全部
        </Button>
      </div>
    </Overlay>

    <script type="application/json" id="knowledge-preview-data" set:html={payloadJson}></script>
    <script>
      import "../scripts/knowledge-preview.client.js";
    </script>
  </>
)}

<style>
.knowledge-related {
  margin-top: var(--space-6);
  margin-bottom: var(--space-6);
  padding-top: var(--space-5);
  border-top: 1px solid var(--rock-basalt);
}

.related-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--rock-granite);
  margin-bottom: var(--space-3);
}

.related-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.related-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--paper-bone);
  border: var(--border-solid);
  padding: var(--space-1) var(--space-3);
  text-decoration: none;
  background: transparent;
  cursor: pointer;
  transition:
    border-color var(--duration-base) var(--ease-out),
    color var(--duration-base) var(--ease-out),
    background var(--duration-base) var(--ease-out);
}

.related-tag:hover,
.related-tag[aria-expanded="true"] {
  border-color: var(--mineral-copper);
  color: var(--mineral-copper);
  background: var(--bg-surface-2);
}

.related-tag:focus-visible {
  outline: 2px solid var(--mineral-copper);
  outline-offset: 2px;
}

.knowledge-preview-body {
  margin: 0 0 var(--space-5) 0;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 1.7;
  color: var(--paper-bone);
  white-space: pre-wrap;
  word-break: break-word;
}

.knowledge-preview-actions {
  display: flex;
  align-items: center;
  gap: var(--space-4);
  padding-top: var(--space-4);
  border-top: 1px solid var(--border-solid);
}
</style>
