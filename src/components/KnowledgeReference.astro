---
interface KnowledgeEntry {
  term: string;
  slug: string;
  summary?: string;
}

interface Props {
  entries: KnowledgeEntry[];
}

const { entries } = Astro.props;
---

{entries.length > 0 && (
  <section class="knowledge-related">
    <div class="related-title">RELATED KNOWLEDGE</div>
    <div class="related-list">
      {entries.map((entry) => (
        <a href={`/knowledge/${entry.slug}`} class="related-tag">{entry.term}</a>
      ))}
    </div>
  </section>
)}

<style>
.knowledge-related {
  margin-top: var(--space-6);
  margin-bottom: var(--space-6);
  padding-top: var(--space-5);
  border-top: 1px solid var(--rock-basalt);
}

.related-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--rock-granite);
  margin-bottom: var(--space-3);
}

.related-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.related-tag {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--paper-bone);
  border: var(--border-solid);
  padding: var(--space-1) var(--space-3);
  text-decoration: none;
  transition: border-color var(--duration-base) var(--ease-out), color var(--duration-base) var(--ease-out);
}

.related-tag:hover {
  border-color: var(--mineral-copper);
  color: var(--mineral-copper);
}
</style>
