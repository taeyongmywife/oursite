---
/**
 * Between 彩蛋散点组件。
 * 在视口各处（边缘、留白、主视觉附近）散落 1–3 个低对比度 "between" 入口，
 * 点击均跳转 /between（由 between.astro 负责从 CMS 随机抽一条、且避免与上次重复）。
 * 视觉沿用已确认的 .between-easter-egg 风格：默认低对比度、hover 过渡到 --text-primary、150ms ease。
 *
 * seed 由调用方（BaseLayout 按 pathname 派生）传入，使不同页面散点分布不同，
 * 形成"偶然发现"的彩蛋感，而非规律出现的固定导航。
 */
interface Props {
  seed?: number;
  count?: number;
}

const { seed = 0, count } = Astro.props;

// 更大的散点池：包含边缘、中央附近、主视觉区域附近。
// 所有坐标使用百分比，fixed 定位，z-index 低于 Nav/SearchOverlay 但可点击。
const spots = [
  // 左上 / 右上边缘
  { top: "12%", left: "2%" },
  { top: "18%", right: "2%" },
  // 左侧中段 / 右侧中段
  { top: "38%", left: "1.5%" },
  { top: "44%", right: "1.5%" },
  // 中央偏上（主视觉附近）
  { top: "28%", left: "48%" },
  // 中央偏左 / 偏右
  { top: "54%", left: "6%" },
  { top: "58%", right: "7%" },
  // 左下 / 右下
  { bottom: "22%", left: "2.5%" },
  { bottom: "30%", right: "2.5%" },
  // 页面底部中央附近
  { bottom: "12%", left: "46%" },
  // 标题区域附近（高位中央）
  { top: "8%", right: "18%" },
  { top: "10%", left: "16%" },
];

// 确定性伪随机：seed → 0..1
const rnd = (s: number) => {
  let t = (s + 0x6d2b79f5) >>> 0;
  t = Math.imul(t ^ (t >>> 15), t | 1);
  t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// 1–3 个入口
const n = count ?? 1 + (Math.floor(rnd(seed) * 10) % 3);

// Fisher-Yates 确定性洗牌后取前 n 个，避免重复、分布更随机
const shuffle = (arr: typeof spots, s: number) => {
  const a = [...arr];
  let state = s >>> 0;
  for (let i = a.length - 1; i > 0; i--) {
    state = (state * 1664525 + 1013904223) >>> 0;
    const j = state % (i + 1);
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
};

const picks = shuffle(spots, seed).slice(0, n);
---

<div class="between-egg-field" aria-hidden="false">
  {
    picks.map((p) => (
      <a
        href="/between"
        class="between-egg"
        style={Object.entries(p)
          .map(([k, v]) => `${k}:${v}`)
          .join(";")}
        aria-label="between"
      >between</a>
    ))
  }
</div>

<style>
  .between-egg-field {
    display: contents; /* 不生成额外盒子，仅作语义包裹；链接各自 fixed 定位 */
  }

  .between-egg {
    position: fixed;
    z-index: 4;
    pointer-events: auto;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.22em;
    color: var(--text-dim);
    text-decoration: none;
    opacity: 0.85;
    transition: color 150ms var(--ease-out), opacity 150ms var(--ease-out);
  }

  .between-egg:hover {
    color: var(--text-primary);
    opacity: 1;
  }

  /* 移动端边缘空间不足，隐藏以免遮挡正文点击 */
  @media (max-width: 768px) {
    .between-egg-field {
      display: none;
    }
  }
</style>
