---
interface Props {
  id: string;
  href: string;
  titleCn: string;
  titleEn?: string;
  category?: string;
  status?: string;
  price?: string | number;
  coverImage?: string;
}

const { id, href, titleCn, titleEn, category, status, price, coverImage } = Astro.props;

const statusLabel: Record<string, string> = {
  available: 'AVAILABLE',
  unavailable: 'UNAVAILABLE',
  draft: 'DRAFT',
};
const statusClass = status ? `status-${status}` : '';
const displayPrice =
  price !== undefined && price !== null && price !== ''
    ? String(price)
    : '';
---

<a href={href} class="product-card">
  <div class="product-cover">
    {coverImage && (
      <img src={coverImage} alt={titleCn} class="product-image" />
    )}
    {status && (
      <span class={`product-status ${statusClass}`}>{statusLabel[status] ?? status.toUpperCase()}</span>
    )}
  </div>
  <div class="product-content">
    {category && <div class="product-category">{category}</div>}
    <h3 class="product-title">{titleCn}</h3>
    {titleEn && <div class="product-subject">{titleEn}</div>}
    {displayPrice && <div class="product-meta">
      <span class="product-price">{displayPrice}</span>
    </div>}
  </div>
</a>

<style>
.product-card {
  display: flex;
  flex-direction: column;
  height: 100%;
  border: var(--border-thin);
  background: var(--bg-shelf);
  text-decoration: none;
  transition: all var(--duration-base) var(--ease-out);
  overflow: hidden;
}

.product-card:hover {
  border-color: var(--mineral-copper);
}

.product-cover {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  background: var(--bg-display);
  overflow: hidden;
}

.product-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-status {
  position: absolute;
  top: var(--space-2);
  left: var(--space-2);
  font-family: var(--font-mono);
  font-size: 10px;
  letter-spacing: 0.1em;
  padding: 2px 6px;
  background: rgba(10, 10, 12, 0.85);
  border: 1px solid var(--rock-basalt);
  color: var(--rock-granite);
}

.product-status.status-available {
  color: var(--mineral-copper);
  border-color: var(--mineral-copper);
}

.product-status.status-unavailable {
  color: var(--paper-rust);
}

.product-status.status-draft {
  color: var(--rock-granite);
}

.product-content {
  padding: var(--space-4);
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  flex: 1;
}

.product-category {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--mineral-copper);
}

.product-title {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  color: var(--paper-bone);
  margin: 0;
  line-height: 1.2;
}

.product-subject {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--paper-rust);
  letter-spacing: 0.05em;
  line-height: 1.3;
  overflow: hidden;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-meta {
  margin-top: auto;
  display: flex;
  align-items: flex-start;
}

.product-price {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  color: var(--mineral-copper);
  line-height: 1;
}
</style>
