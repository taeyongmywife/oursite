---
import Layout from "../../layouts/Layout.astro";
import RichText from "../../components/RichText.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import ProductCard from "../../components/cards/ProductCard.astro";
import { getProducts, getProductBySlug, getMarketCategories, type PayloadProduct } from "../../lib/payload";

const labelMap: Record<string, { cn: string; en: string; unit: string }> = {
  toolkit: { cn: "工具", en: "TOOLS", unit: "件" },
  knowledge: { cn: "知识", en: "KNOWLEDGE", unit: "卷" },
  works: { cn: "作品", en: "WORKS", unit: "帧" },
};

export async function getStaticPaths() {
  const products = await getProducts();
  const categories = await getMarketCategories();

  return [
    ...products.map((p, i) => ({
      params: { slug: p.slug },
      props: { type: "product", specimenId: String(i + 1).padStart(3, "0") },
    })),
    ...categories.map((c) => ({
      params: { slug: c.slug },
      props: { type: "category", categorySlug: c.slug },
    })),
  ];
}

const { type, specimenId, categorySlug } = Astro.props;
const isCategory = type === "category";

const product = isCategory ? null : await getProductBySlug(Astro.params.slug);

if (!isCategory && !product) {
  throw new Error(`Product not found for slug: ${Astro.params.slug}`);
}

const getCategorySlug = (p: PayloadProduct): string => {
  const cat = p.category;
  if (typeof cat === "object" && cat !== null) return cat.slug;
  return "";
};

const getTagName = (tag: number | { id: number; title: string; slug: string }): string => {
  return typeof tag === "object" ? tag.title : `Tag #${tag}`;
};

const formatPrice = (p: PayloadProduct): string => {
  if (p.price === null || p.price === undefined) return "";
  const currency = p.currency ?? "";
  return currency ? `${currency} ${p.price}`.trim() : `${p.price}`;
};

// Category view data
const categoryProducts = isCategory
  ? (await getProducts()).filter((p) => getCategorySlug(p) === categorySlug)
  : [];
const categoryLabel = isCategory
  ? labelMap[categorySlug] ?? { cn: categorySlug, en: categorySlug.toUpperCase(), unit: "件" }
  : null;

// Product view data
const statusLabel: Record<string, string> = {
  available: "AVAILABLE",
  unavailable: "UNAVAILABLE",
  draft: "DRAFT",
};
const statusClass = product?.status ? `status-${product.status}` : "";
const formattedPrice =
  product && product.price !== null && product.price !== undefined
    ? `${product.currency ?? ""} ${product.price}`.trim()
    : "";
const categoryTitle = product ? getCategorySlug(product) : "";
const tagList = product && Array.isArray(product.tags) ? product.tags : [];
---

{
  isCategory ? (
    <Layout title={`${categoryLabel?.en} | MARKET`} description={`Market - ${categoryLabel?.en}`}>
      <section class="page">
        <a href="/market" class="back-link">[ BACK TO MARKET ]</a>
        <SectionHeader en={categoryLabel?.en ?? ""} cn={categoryLabel?.cn ?? ""} count={categoryProducts.length} />
        <div class="products-grid">
          {categoryProducts.map((p, index) => (
            <ProductCard
              id={String(categoryProducts.length - index).padStart(3, "0")}
              href={`/market/${p.slug}`}
              titleCn={p.title}
              titleEn={p.shortDescription ?? ""}
              category={getCategorySlug(p)}
              status={p.status}
              price={formatPrice(p)}
              coverImage={p.coverImage?.url}
            />
          ))}
          {categoryProducts.length === 0 && (
            <div class="empty-state">No items in this category yet.</div>
          )}
        </div>
      </section>
    </Layout>
  ) : (
    <Layout title={`${product?.title} | MARKET`} description={product?.shortDescription ?? product?.title ?? ""}>
      <article class="product-detail">
        <div class="product-head">
          <div class="product-label">PRODUCT · #{specimenId}</div>
          <h1 class="product-title">{product?.title}</h1>
          <div class="product-meta-row">
            {product?.productCode && (
              <span class="meta-item">CODE: {product.productCode}</span>
            )}
            {categoryTitle && (
              <span class="meta-item">CAT: {categoryTitle}</span>
            )}
            {product?.status && (
              <span class={`meta-item product-status ${statusClass}`}>
                STATUS: {statusLabel[product.status] ?? product.status.toUpperCase()}
              </span>
            )}
          </div>
        </div>

        {product?.coverImage && (
          <div class="product-cover">
            <img src={product.coverImage.url} alt={product.coverImage.alt || product.title} />
          </div>
        )}

        {formattedPrice && (
          <div class="product-price-row">
            <span class="product-price">{formattedPrice}</span>
          </div>
        )}

        {tagList.length > 0 && (
          <div class="product-tags">
            <div class="tags-title">TAGS</div>
            <div class="tags-list">
              {tagList.map((tag) => (
                <span class="tag-chip">{getTagName(tag)}</span>
              ))}
            </div>
          </div>
        )}

        {product?.description && (
          <div class="product-content">
            <RichText content={product.description as { root: unknown }} />
          </div>
        )}

        <a href="/market" class="back-link">[ BACK TO MARKET ]</a>
      </article>
    </Layout>
  )
}

<style>
.page {
  padding: var(--space-16) 0;
}

.back-link {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--paper-bone);
  text-decoration: none;
  margin-bottom: var(--space-8);
}

.back-link:hover {
  color: var(--mineral-copper);
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--space-6);
}

.empty-state {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--rock-granite);
  padding: var(--space-12) 0;
  text-align: center;
  grid-column: 1 / -1;
}

.product-detail {
  padding: var(--space-16) 0;
  max-width: 680px;
  margin: 0 auto;
}

.product-head {
  padding-bottom: var(--space-6);
  border-bottom: 1px solid var(--rock-basalt);
}

.product-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.1em;
  color: var(--rock-granite);
  text-transform: uppercase;
  margin-bottom: var(--space-3);
}

.product-title {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  font-weight: 400;
  color: var(--paper-bone);
  margin: 0 0 var(--space-4) 0;
}

.product-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-4);
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.05em;
  color: var(--paper-rust);
}

.product-status.status-available {
  color: var(--mineral-copper);
}

.product-status.status-unavailable {
  color: var(--paper-rust);
}

.product-status.status-draft {
  color: var(--rock-granite);
}

.product-cover {
  margin: var(--space-12) 0;
  width: 100%;
  aspect-ratio: 16/9;
  border: var(--border-solid);
  background: var(--bg-shelf);
  overflow: hidden;
}

.product-cover img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.product-price-row {
  padding: var(--space-6) 0;
  border-top: var(--border-thin);
  border-bottom: var(--border-thin);
}

.product-price {
  font-family: var(--font-serif);
  font-size: var(--text-2xl);
  color: var(--mineral-copper);
}

.product-tags {
  margin: var(--space-8) 0;
}

.tags-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--paper-bone);
  margin-bottom: var(--space-4);
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-2);
}

.tag-chip {
  display: inline-block;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--paper-bone);
  border: var(--border-solid);
  padding: var(--space-1) var(--space-3);
}

.product-content {
  font-size: var(--text-base);
  line-height: 1.75;
  color: var(--paper-bone);
  margin-top: var(--space-12);
}

.product-content :global(p) {
  margin: 0 0 var(--space-4) 0;
}

.product-content :global(h2) {
  font-size: var(--text-lg);
  font-weight: var(--font-semibold);
  margin: var(--space-8) 0 var(--space-4) 0;
}

.product-content :global(ul) {
  margin: 0 0 var(--space-4) 0;
  padding-left: var(--space-6);
}

.product-content :global(blockquote) {
  margin: var(--space-6) 0;
  padding: var(--space-3) var(--space-5);
  border-left: 2px solid var(--mineral-copper);
  background: var(--bg-shelf);
  color: var(--paper-rust);
}

.product-content :global(pre) {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  line-height: 1.5;
  overflow-x: auto;
  padding: var(--space-4);
  background: var(--bg-shelf);
  border: var(--border-thin);
  margin: var(--space-4) 0;
}

.product-content :global(code) {
  font-family: var(--font-mono);
  font-size: 0.9em;
}

.product-content :global(a) {
  color: var(--mineral-copper);
  text-decoration: none;
}

.product-content :global(a:hover) {
  text-decoration: underline;
}

@media (max-width: 768px) {
  .products-grid {
    grid-template-columns: 1fr;
  }
}
</style>
