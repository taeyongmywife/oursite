---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import CategoryCard from "../../components/CategoryCard.astro";
import ProductCard from "../../components/cards/ProductCard.astro";
import { getProducts, getMarketCategories, type PayloadProduct, type PayloadMarketCategory } from "../../lib/payload";

const products = await getProducts();
const categories = await getMarketCategories();

// Presentation layer: CMS stores English titles only.
// Map slug -> bilingual labels + count unit. Extend as new market categories appear.
const labelMap: Record<string, { cn: string; en: string; unit: string }> = {
  toolkit: { cn: "工具", en: "TOOLS", unit: "件" },
  knowledge: { cn: "知识", en: "KNOWLEDGE", unit: "卷" },
  works: { cn: "作品", en: "WORKS", unit: "帧" },
};

const getCategorySlug = (p: PayloadProduct): string => {
  const cat = p.category;
  if (typeof cat === "object" && cat !== null) return cat.slug;
  return "";
};

const formatPrice = (p: PayloadProduct): string => {
  if (p.price === null || p.price === undefined) return "";
  const currency = p.currency ?? "";
  return currency ? `${currency} ${p.price}` : `${p.price}`;
};

const categoryCards = categories.map((cat: PayloadMarketCategory, i) => {
  const label = labelMap[cat.slug] ?? { cn: cat.title, en: cat.title.toUpperCase(), unit: "件" };
  const count = products.filter((p) => getCategorySlug(p) === cat.slug).length;
  return {
    id: String(i + 1).padStart(3, "0"),
    titleCn: label.cn,
    titleEn: label.en,
    description: cat.description ?? label.cn,
    descriptionEn: cat.title,
    count,
    unit: label.unit,
    category: cat.slug,
    href: `/market/${cat.slug}`,
  };
});

// Recently added (latest 5 by updatedAt)
const featuredProducts = products.slice(0, 5);
const productIndex = new Map(products.map((p, i) => [p.slug, i]));
---

<Layout title="MARKET | BubbleCrisp" description="Market - 安静的策展商店">
  <section class="page">
    <SectionHeader en="MARKET" cn="策展商店" count={products.length} />

    <!-- Visual Center: Categories (dynamic from CMS) -->
    <div class="categories-section">
      <div class="categories-grid">
        {categoryCards.map((cat) => (
          <CategoryCard {...cat} />
        ))}
      </div>
    </div>

    <!-- Minimalist Section: Recently Added -->
    <div class="recent-section">
      <div class="recent-header">
        <div class="recent-title">RECENTLY ADDED</div>
        <div class="recent-line"></div>
      </div>
      <div class="products-row">
        {featuredProducts.map((product) => (
          <div class="product-item">
            <ProductCard
              id={String((productIndex.get(product.slug) ?? 0) + 1).padStart(3, "0")}
              href={`/market/${product.slug}`}
              titleCn={product.title}
              titleEn={product.shortDescription ?? ""}
              category={getCategorySlug(product)}
              status={product.status}
              price={formatPrice(product)}
              coverImage={product.coverImage?.url}
            />
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>

<style>
.page {
  padding: var(--space-16) 0;
  display: flex;
  flex-direction: column;
  gap: var(--space-24);
}

/* Categories Section - Refined Size */
.categories-section {
  width: 100%;
  max-width: 900px;
  margin: 0 auto;
}

.categories-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--space-4);
}

/* Recent Section - Subordinate & Horizontal */
.recent-section {
  display: flex;
  flex-direction: column;
  gap: var(--space-8);
}

.recent-header {
  display: flex;
  align-items: center;
  gap: var(--space-4);
}

.recent-title {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--rock-granite);
  white-space: nowrap;
}

.recent-line {
  flex: 1;
  height: 1px;
  background: var(--rock-basalt);
}

.products-row {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--space-4);
}

.product-item {
  width: 100%;
  display: flex;
}

/* Override ProductCard styles for small size in row */
.product-item :global(.product-content) {
  padding: var(--space-3);
}

.product-item :global(.product-title) {
  font-size: var(--text-sm);
  line-height: 1.2;
}

.product-item :global(.product-subject) {
  font-size: var(--text-xs);
  line-height: 1.2;
  -webkit-line-clamp: 2;
}

.product-item :global(.product-price) {
  font-size: var(--text-base);
  line-height: 1;
}

@media (max-width: 1024px) {
  .categories-grid {
    gap: var(--space-4);
  }
}

@media (max-width: 768px) {
  .page {
    gap: var(--space-16);
  }

  .categories-grid {
    grid-template-columns: 1fr;
  }

  .products-row {
    gap: var(--space-2);
  }

  .product-item :global(.product-title) {
    font-size: var(--text-xs);
  }
}
</style>
