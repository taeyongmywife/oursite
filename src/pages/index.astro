---
import Layout from "../layouts/Layout.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { getCollection } from 'astro:content';
import { postPathOf } from '../lib/payload';

const payloadUrl = import.meta.env.PUBLIC_PAYLOAD_URL;
let posts = [];

try {
  const res = await fetch(`${payloadUrl}/api/posts`);
  if (res.ok) {
    const data = await res.json();
    posts = data.docs ?? [];
  } else {
    console.warn(`[home] Posts fetch returned ${res.status}`);
  }
} catch (err) {
  console.warn(`[home] Failed to fetch posts: ${err}`);
}

const fragments = await getCollection("fragments");
const latestFragments = [...fragments].sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const currentId = String(fragments.length).padStart(4, "0");

// 最近文章按创建时间倒序，首页只展示 3 条，避免过于密集
const recentPosts = [...posts].sort(
  (a, b) => new Date(b.createdAt ?? 0).getTime() - new Date(a.createdAt ?? 0).getTime()
).slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero">
    <div class="hero-top">
      <div class="hero-welcome">WELCOME, STRANGER.</div>
      <div class="hero-id">[SPECIMEN #{currentId}]</div>
    </div>

    <h1 class="hero-title-cn">你正在进入一个未命名空间</h1>
    <div class="hero-title-en">Entering an Unnamed Space</div>

    <div class="hero-line"></div>

    <div class="hero-desc">
      <p>这里存放着持续结晶的想法、观察、产物。</p>
      <p>Each idea here is a specimen in a cabinet still being built.</p>
    </div>

    <a class="hero-cta" href="/fragments">[<span class="cta-arrow">▸</span> ENTER THE CABINET]</a>
  </section>

  <section class="recent">
    <div class="recent-title">RECENT CRYSTALLIZATION · 最近结晶</div>
    <div class="recent-list">
      {recentPosts.map((post) => {
        const cat = typeof post.category === "object" && post.category !== null
          ? post.category.slug
          : null;
        const href = postPathOf(post);
        const date = post.createdAt?.split("T")[0]?.replace(/-/g, ".") ?? "";
        return (
          <a href={href} class="recent-row">
            <span class="recent-row-title">{post.title}</span>
            <span class="recent-row-meta">
              {cat && <span class="recent-row-cat">{cat}</span>}
              {date && <span class="recent-row-date">{date}</span>}
            </span>
          </a>
        );
      })}
    </div>
  </section>
</Layout>

<style>
.hero {
  position: relative;
  padding: var(--space-16) 0 var(--space-12) 0;
}

.hero-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-4);
}

.hero-welcome {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--rock-granite);
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.hero-id {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--mineral-copper);
  letter-spacing: 0.1em;
}

.hero-title-cn {
  font-family: var(--font-serif);
  font-size: var(--text-4xl);
  font-weight: 600;
  line-height: 1.15;
  margin: var(--space-6) 0 var(--space-2) 0;
}

.hero-title-en {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--paper-rust);
  letter-spacing: 0.1em;
}

.hero-line {
  height: 1px;
  background: var(--rock-basalt);
  margin: var(--space-6) 0;
}

.hero-desc {
  display: flex;
  flex-direction: column;
  gap: var(--space-2);
  color: var(--paper-bone);
}

.hero-desc p {
  margin: 0;
}

.hero-cta {
  position: relative;
  display: inline-block;
  margin-top: var(--space-8);
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  letter-spacing: 0.1em;
  text-decoration: none;
  color: var(--paper-bone);
  transition: color 150ms var(--ease-out);
}

.cta-arrow {
  display: inline-block;
  transition: transform 150ms var(--ease-out);
}

.hero-cta:hover {
  color: var(--mineral-copper);
}

.hero-cta:hover .cta-arrow {
  transform: translateX(4px);
}

.hero-cta::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -3px;
  height: 1px;
  background: var(--accent);
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 180ms var(--ease-out);
}

.hero-cta:hover::after {
  transform: scaleX(1);
}

.recent {
  padding: var(--space-24) 0 var(--space-24) 0;
}

.recent-title {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: var(--paper-bone);
  margin-bottom: var(--space-12);
}

.recent-list {
  display: flex;
  flex-direction: column;
}

.recent-row {
  position: relative;
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  gap: var(--space-4);
  padding: var(--space-6) var(--space-4) var(--space-6) var(--space-6);
  text-decoration: none;
  transition: background var(--duration-fast) var(--ease-out);
}

.recent-row + .recent-row {
  border-top: 1px solid var(--border);
}

.recent-row::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 2px;
  background: var(--accent);
  transform: scaleY(0);
  transform-origin: center;
  transition: transform var(--duration-fast) var(--ease-out);
}

.recent-row:hover {
  background: var(--bg-surface-2);
}

.recent-row:hover::before {
  transform: scaleY(1);
}

.recent-row-title {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  color: var(--text-muted);
  transition: color var(--duration-fast) var(--ease-out);
}

.recent-row:hover .recent-row-title {
  color: var(--text-primary);
}

.recent-row-meta {
  display: inline-flex;
  align-items: baseline;
  gap: var(--space-3);
  flex-shrink: 0;
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--rock-granite);
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

@media (max-width: 768px) {
  .hero {
    padding: var(--space-12) 0;
  }

  .hero-top {
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-2);
  }

  .hero-title-cn {
    font-size: clamp(2rem, 9vw, 2.5rem);
    margin-top: var(--space-4);
  }

  .hero-title-en {
    letter-spacing: 0.06em;
    line-height: 1.5;
  }

  .hero-cta {
    margin-top: var(--space-6);
    font-size: var(--text-xs);
  }

  .recent {
    padding: var(--space-16) 0 var(--space-16) 0;
  }

  .recent-row {
    padding: var(--space-4) 0 var(--space-4) var(--space-4);
  }

  .recent-row-title {
    font-size: var(--text-base);
  }
}
</style>
