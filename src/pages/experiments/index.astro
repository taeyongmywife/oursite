---
import Layout from "../../layouts/Layout.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import TagBox from "../../components/TagBox.astro";
import { getPosts, groupPostsByTag } from "../../lib/payload";

const experiments = await getPosts("experiment");
const tagGroups = groupPostsByTag(experiments);
---

<Layout title="EXPERIMENTS · IN PROGRESS | BubbleCrisp" description="Experiment Lab - A record of ongoing projects.">
  <section class="page">
    <SectionHeader en="EXPERIMENTS · IN PROGRESS" cn="实验记录 · 在制品" count={experiments.length} />
    <p class="section-intro">
      Ongoing systems and small tests. The lab stays dim, but active.
    </p>

    {tagGroups.length > 0 ? (
      <div class="tag-group">
        {tagGroups.map((group) => (
          <TagBox tag={group.tag} posts={group.posts} basePath="/experiments" />
        ))}
      </div>
    ) : (
      <div class="empty">暂无实验记录。</div>
    )}
  </section>
</Layout>

<style>
.page {
  position: relative;
  padding: var(--space-16) 0;
}

.section-intro {
  position: relative;
  z-index: 1;
  margin: 0 0 var(--space-8) 0;
  color: var(--paper-rust);
}

.tag-group {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
}

.empty {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  color: var(--rock-granite);
  text-align: center;
  padding: var(--space-16) 0;
}
</style>
