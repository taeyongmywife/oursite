---
import Layout from "../../layouts/Layout.astro";
import ChoicePanel from "../../components/ChoicePanel.astro";
import SpecimenLabel from "../../components/SpecimenLabel.astro";
import { getKnowledgeSlugs, getKnowledgeBySlug, lexicalToHtml } from "../../lib/payload";

export async function getStaticPaths() {
  const slugs = await getKnowledgeSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const slug = Astro.params.slug!;
const entry = await getKnowledgeBySlug(slug);

if (!entry) {
  return Astro.redirect('/404');
}

const contentHtml = entry.content ? lexicalToHtml(entry.content) : '';
const collected = entry.createdAt.split('T')[0];

// Resolve related terms (depth=1 populates them)
const relatedTerms: { term: string; slug: string }[] = [];
if (entry.relatedTerms && Array.isArray(entry.relatedTerms)) {
  for (const rt of entry.relatedTerms) {
    if (typeof rt === 'object' && rt.term && rt.slug) {
      relatedTerms.push({ term: rt.term, slug: rt.slug });
    }
  }
}

// Resolve related collections (depth=1 populates them)
const relatedCollections: { title: string; slug: string; description?: string }[] = [];
if (entry.relatedCollections && Array.isArray(entry.relatedCollections)) {
  for (const rc of entry.relatedCollections) {
    if (typeof rc === 'object' && rc.title && rc.slug) {
      relatedCollections.push({ title: rc.title, slug: rc.slug, description: rc.description });
    }
  }
}

// Resolve aliases
const aliases: string[] = [];
if (entry.aliases && Array.isArray(entry.aliases)) {
  for (const a of entry.aliases) {
    if (a.alias) aliases.push(a.alias);
  }
}

const composition = aliases.length > 0 ? aliases.join(' / ') : entry.slug;
---

<Layout title={`${entry.term} | KNOWLEDGE`} description={entry.summary ?? entry.term}>
  <article class="knowledge-detail">
    <SpecimenLabel
      id={String(entry.id).padStart(4, '0')}
      titleCn={entry.term}
      titleEn="KNOWLEDGE INDEX"
      collected={collected}
      location="cabinet classification"
      composition={composition}
      status={entry.published ? "crystallizing" : "forming"}
      variant="full"
    />

    {entry.summary && (
      <div class="knowledge-summary">
        <div class="summary-label">SUMMARY</div>
        <p>{entry.summary}</p>
      </div>
    )}

    {contentHtml && (
      <div class="knowledge-content prose">
        <div set:html={contentHtml} />
      </div>
    )}

    {relatedTerms.length > 0 && (
      <section class="related-section">
        <div class="related-line"></div>
        <div class="related-header">
          <div class="related-title-en">RELATED TERMS</div>
          <div class="related-title-cn">关联词条</div>
        </div>
        <div class="related-list">
          {relatedTerms.map((rt) => (
            <a href={`/knowledge/${rt.slug}`} class="related-item">
              <div class="related-type">TERM</div>
              <div class="related-title">{rt.term}</div>
            </a>
          ))}
        </div>
      </section>
    )}

    {relatedCollections.length > 0 && (
      <section class="related-section">
        <div class="related-line"></div>
        <div class="related-header">
          <div class="related-title-en">RELATED COLLECTIONS</div>
          <div class="related-title-cn">关联合集</div>
        </div>
        <div class="related-list">
          {relatedCollections.map((rc) => (
            <a href={`/market/${rc.slug}`} class="related-item">
              <div class="related-type">COLLECTION</div>
              <div class="related-title">{rc.title}</div>
              {rc.description && <div class="related-desc">{rc.description}</div>}
            </a>
          ))}
        </div>
      </section>
    )}

    <ChoicePanel
      prompt="Continue exploring."
      options={[
        { label: "Back to blog", href: "/blog" },
        { label: "Enter fragments", href: "/fragments" },
      ]}
    />
  </article>
</Layout>

<style>
.knowledge-detail {
  padding: var(--space-16) 0;
  max-width: 68ch;
  margin: 0 auto;
}

.knowledge-summary {
  margin-top: var(--space-8);
  padding: var(--space-6);
  border: var(--border-thin);
  background: rgba(10, 10, 12, 0.72);
}

.summary-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--mineral-copper);
  letter-spacing: 0.15em;
  text-transform: uppercase;
  margin-bottom: var(--space-3);
}

.knowledge-summary p {
  font-family: var(--font-serif);
  font-size: var(--text-base);
  color: var(--paper-bone);
  line-height: 1.7;
  margin: 0;
}

.knowledge-content {
  margin-top: var(--space-12);
}

.prose {
  color: var(--paper-bone);
  line-height: 1.75;
}

.prose :global(p) {
  margin: 0 0 var(--space-6) 0;
}

.prose :global(h2) {
  margin: var(--space-12) 0 var(--space-4) 0;
  font-size: var(--text-2xl);
  font-weight: 400;
}

.prose :global(h3) {
  margin: var(--space-8) 0 var(--space-3) 0;
  font-size: var(--text-xl);
  font-weight: 400;
}

.prose :global(a) {
  color: var(--mineral-copper);
}

.prose :global(pre) {
  border: var(--border-thin);
  background: var(--bg-shelf);
  padding: var(--space-4);
  overflow-x: auto;
}

.prose :global(code) {
  font-family: var(--font-mono);
  font-size: 0.95em;
}

.prose :global(ul), .prose :global(ol) {
  margin: 0 0 var(--space-6) 0;
  padding-left: var(--space-6);
}

.prose :global(li) {
  margin-bottom: var(--space-2);
}

.prose :global(hr) {
  border: none;
  border-top: var(--border-solid);
  margin: var(--space-8) 0;
}

/* Related sections — same pattern as RelatedReferences */
.related-section {
  margin-top: var(--space-16);
}

.related-line {
  height: 1px;
  background: var(--rock-granite);
  margin-bottom: var(--space-8);
}

.related-header {
  margin-bottom: var(--space-6);
  display: flex;
  flex-direction: column;
  gap: var(--space-1);
}

.related-title-en {
  font-family: var(--font-mono);
  font-size: var(--text-sm);
  letter-spacing: 0.15em;
  color: var(--rock-granite);
  text-transform: uppercase;
}

.related-title-cn {
  font-family: var(--font-serif);
  font-size: var(--text-lg);
  color: var(--paper-bone);
}

.related-list {
  display: flex;
  flex-direction: column;
  gap: var(--space-3);
}

.related-item {
  display: block;
  padding: var(--space-4) var(--space-6);
  border: var(--border-thin);
  text-decoration: none;
  transition: all var(--duration-base) var(--ease-out);
}

.related-item:hover {
  border-color: var(--mineral-copper);
}

.related-type {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--mineral-copper);
  letter-spacing: 0.1em;
  margin-bottom: var(--space-1);
}

.related-title {
  font-family: var(--font-serif);
  font-size: var(--text-base);
  color: var(--paper-bone);
}

.related-desc {
  font-family: var(--font-serif);
  font-size: var(--text-sm);
  color: var(--paper-rust);
  margin-top: var(--space-2);
}

@media (max-width: 768px) {
  .knowledge-detail {
    padding: var(--space-12) 0;
  }

  .knowledge-summary {
    padding: var(--space-4);
  }
}
</style>
