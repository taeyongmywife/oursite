---
import Layout from "../../layouts/Layout.astro";
import ChoicePanel from "../../components/ChoicePanel.astro";
import MineralFigure from "../../components/MineralFigure.astro";
import SpecimenLabel from "../../components/SpecimenLabel.astro";
import RichText from "../../components/RichText.astro";
import KnowledgeReference from "../../components/KnowledgeReference.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import { getPostBySlug, getPosts, type PayloadPost } from "../../lib/payload";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts
    .filter((p) => p.status === "published")
    .map((post) => ({
      params: { slug: post.slug },
    }));
}

const slug = Astro.params.slug!;
const post = await getPostBySlug(slug);

if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`);
}

const allPosts = await getPosts();
const specimenId = String(allPosts.findIndex((p) => p.slug === slug) + 1).padStart(4, "0");
const collected = post.createdAt.split("T")[0];

const categoryLabel =
  typeof post.category === "object" && post.category !== null
    ? post.category.title
    : String(post.category);

const knowledgeEntries =
  Array.isArray(post.knowledgeIndex)
    ? post.knowledgeIndex.map((ki) => {
        if (typeof ki === "object" && ki !== null) {
          return { term: ki.term, slug: ki.slug, summary: ki.summary ?? undefined };
        }
        return null;
      })
      .filter(Boolean)
    : [];

const coverUrl =
  post.cover && typeof post.cover === "object" && post.cover !== null
    ? (post.cover as { url?: string }).url ?? undefined
    : undefined;
---

<Layout title={`${post.title} | BLOG`} description={post.excerpt ?? post.title}>
  <article class="post">
    <SpecimenLabel
      id={specimenId}
      titleCn={post.title}
      titleEn={categoryLabel}
      collected={collected}
      location="digital sediment"
      composition={categoryLabel}
      status="crystallizing"
      variant="full"
    />

    {coverUrl && (
      <div class="hero-figure">
        <MineralFigure src={coverUrl} alt={post.title} caption="Specimen figure" />
      </div>
    )}

    <div class="prose">
      <RichText content={post.content as { root: unknown }} />
    </div>

    <KnowledgeReference entries={knowledgeEntries} />

    <SeriesNav post={post} />

    <ChoicePanel
      prompt="Close this file."
      options={[
        { label: "Back to blog", href: "/blog" },
        { label: "Enter fragments", href: "/fragments" },
      ]}
    />
  </article>
</Layout>

<style>
.post {
  padding: var(--space-16) 0;
  max-width: 68ch;
  margin: 0 auto;
}

.hero-figure {
  margin-top: var(--space-8);
}

.prose {
  margin-top: var(--space-12);
  color: var(--paper-bone);
  line-height: 1.75;
}

.prose :global(p) {
  margin: 0 0 var(--space-6) 0;
}

.prose :global(h2) {
  margin: var(--space-12) 0 var(--space-4) 0;
  font-size: var(--text-2xl);
  font-weight: 400;
}

.prose :global(h3) {
  margin: var(--space-8) 0 var(--space-3) 0;
  font-size: var(--text-xl);
  font-weight: 400;
}

.prose :global(a) {
  color: var(--mineral-copper);
}

.prose :global(pre) {
  border: var(--border-thin);
  background: var(--bg-shelf);
  padding: var(--space-4);
  overflow-x: auto;
}

.prose :global(code) {
  font-family: var(--font-mono);
  font-size: 0.95em;
}
</style>
