---
import Layout from "../../layouts/Layout.astro";
import ChoicePanel from "../../components/ChoicePanel.astro";
import MineralFigure from "../../components/MineralFigure.astro";
import SpecimenLabel from "../../components/SpecimenLabel.astro";
import RichText from "../../components/RichText.astro";
import KnowledgeReference from "../../components/KnowledgeReference.astro";
import LLMResponseCite from "../../components/LLMResponseCite.astro";
import SeriesNav from "../../components/SeriesNav.astro";
import TagBoxChips from "../../components/TagBoxChips.astro";
import RelatedContent from "../../components/RelatedContent.astro";
import { getPostBySlug, getPosts, getKnowledgeList, buildKnowledgeMap, buildKnowledgeEntries, getMatchedKnowledge, getSeriesAdjacent, extractLLMResponses, type PayloadPost } from "../../lib/payload";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts
    .filter((p) => p.status === "published")
    .map((post) => ({
      params: { slug: post.slug },
    }));
}

const slug = Astro.params.slug!;
const post = await getPostBySlug(slug);

if (!post) {
  throw new Error(`Blog post not found for slug: ${slug}`);
}

const allPosts = await getPosts();
const specimenId = String(allPosts.findIndex((p) => p.slug === slug) + 1).padStart(4, "0");
const collected = post.createdAt.split("T")[0];

const categoryLabel =
  typeof post.category === "object" && post.category !== null
    ? post.category.title
    : String(post.category);

const knowledgeList = await getKnowledgeList();
const knowledgeMap = buildKnowledgeMap(knowledgeList);
const knowledgeEntryInfo = buildKnowledgeEntries(knowledgeList);
// 自动扫描正文：基于 term + aliases 命中，取代手动 knowledgeIndex 关联
const knowledgeEntries = getMatchedKnowledge(post.content, knowledgeList);

const coverUrl =
  post.cover && typeof post.cover === "object" && post.cover !== null
    ? (post.cover as { url?: string }).url ?? undefined
    : undefined;

const { prevSlug, nextSlug } = await getSeriesAdjacent(post);
const seriesAdjacentSlugs = [prevSlug, nextSlug].filter(
  (s): s is string => Boolean(s)
);

// LLM Review「查看原文」引用（llmResponse 节点 → 页面级 JSON payload）
const llmCites = extractLLMResponses(post.content);
---

<Layout title={`${post.title} | BLOG`} description={post.excerpt ?? post.title}>
  <article class="post">
    <SpecimenLabel
      id={specimenId}
      title={post.title}
      collected={collected}
      composition={categoryLabel}
      status="crystallizing"
      variant="full"
    />

    {coverUrl && (
      <div class="hero-figure">
        <MineralFigure src={coverUrl} alt={post.title} caption="Specimen figure" />
      </div>
    )}

    <KnowledgeReference entries={knowledgeEntries} />

    <TagBoxChips post={post} />

    <div class="prose">
      <RichText content={post.content as { root: unknown }} knowledgeMap={knowledgeMap} knowledgeEntries={knowledgeEntryInfo} />
    </div>

    <LLMResponseCite cites={llmCites} />

    <SeriesNav post={post} />

    <RelatedContent post={post} excludeSlugs={seriesAdjacentSlugs} />

    <ChoicePanel
      cn="收起档案"
      en="Close this file"
      options={[
        { cn: "回到博客", en: "Back to blog", href: "/blog" },
        { cn: "进入碎片", en: "Enter fragments", href: "/fragments" },
      ]}
    />
  </article>
</Layout>

<style>
.post {
  padding: var(--space-16) 0;
  max-width: 68ch;
  margin: 0 auto;
}

.hero-figure {
  margin-top: var(--space-8);
}

.prose {
  margin-top: var(--space-12);
  color: var(--paper-bone);
  line-height: 1.75;
}

.prose :global(p) {
  margin: 0 0 var(--space-6) 0;
}

.prose :global(h2) {
  margin: var(--space-12) 0 var(--space-4) 0;
  font-size: var(--text-2xl);
  font-weight: 400;
}

.prose :global(h3) {
  margin: var(--space-8) 0 var(--space-3) 0;
  font-size: var(--text-xl);
  font-weight: 400;
}

.prose :global(a) {
  color: var(--mineral-copper);
}

.prose :global(pre) {
  border: var(--border-thin);
  background: var(--bg-shelf);
  padding: var(--space-4);
  overflow-x: auto;
}

.prose :global(code) {
  font-family: var(--font-mono);
  font-size: 0.95em;
}
</style>
