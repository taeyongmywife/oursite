---
import Layout from '../../layouts/Layout.astro';
import RockCard from "../../components/RockCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { getPosts, type PayloadPost } from '../../lib/payload';

const posts = await getPosts();
const publishedPosts = posts.filter((p) => p.status === "published");
const featuredPosts = publishedPosts.filter((p) => p.featured);

const toNumericId = (index: number) => String(index + 1).padStart(4, "0");

const getCategoryLabel = (post: PayloadPost): string => {
  if (typeof post.category === "object" && post.category !== null) {
    return post.category.title;
  }
  return String(post.category);
};

const getDate = (post: PayloadPost): string => {
  const raw = post.publishedAt ?? post.createdAt;
  const d = new Date(raw);
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, "0");
  const day = String(d.getDate()).padStart(2, "0");
  return `${y}.${m}.${day}`;
};

const getCategorySlug = (post: PayloadPost): string => {
  if (typeof post.category === "object" && post.category !== null) {
    return post.category.slug;
  }
  return "";
};
---

<Layout title="BLOG | BubbleCrisp">
  <section class="page">
    <SectionHeader en="BLOG" cn="档案文本" count={publishedPosts.length} />
    <p class="subtitle">记录关于 AI、创造、商业与意识的探索样本。</p>

    <div class="posts-region">
      {featuredPosts.length > 0 && (
        <div class="featured-section">
          <p class="section-label">Featured</p>
          <p class="section-title">精选档案</p>
          <div class="posts-grid">
            {featuredPosts.map((post, i) => (
              <RockCard
                href={`/blog/${post.slug}`}
                id={toNumericId(publishedPosts.indexOf(post))}
                titleCn={post.title}
                titleEn={getCategoryLabel(post)}
                date={getDate(post)}
              />
            ))}
          </div>
        </div>
      )}

      <div class="all-section">
        <p class="section-label">Archive</p>
        <p class="section-title">档案库</p>
        <div class="posts-grid">
          {publishedPosts.map((post, i) => (
            <RockCard
              href={`/blog/${post.slug}`}
              id={toNumericId(i)}
              titleCn={post.title}
              titleEn={getCategoryLabel(post)}
              date={getDate(post)}
            />
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
.page {
  padding: var(--space-16) 0;
}

.subtitle {
  font-size: var(--text-lg);
  color: var(--paper-rust);
  line-height: 1.75;
  margin: 0 0 var(--space-8) 0;
}

.posts-region {
  opacity: 1;
}

.featured-section,
.all-section {
  margin-bottom: var(--space-16);
}

.section-label {
  font-family: var(--font-mono);
  font-size: var(--text-xs);
  color: var(--rock-granite);
  text-transform: uppercase;
  letter-spacing: 0.1em;
  margin: 0 0 var(--space-2) 0;
}

.section-title {
  font-family: var(--font-serif);
  font-size: var(--text-xl);
  font-weight: 400;
  margin: 0 0 var(--space-6) 0;
  color: var(--paper-bone);
}

.posts-grid {
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}
</style>
